# modconv1_preproc_verify_q.mpc -- TEST ONLY.
#
# Reveals the final persisted mask m (q-domain) that
# modconv1_preproc_finalize_q.mpc wrote, so the orchestrator can compare
# it against a plaintext-computed expectation. A real deployment never
# does this -- m must stay secret for the online phase to be secure.
#
# Compile-time args: <kappa_retries>

kappa_retries = int(program.args[1])

_, (m,) = sint.read_from_file(2 * kappa_retries, n_items=1)
print_ln('m %s', m.reveal())
